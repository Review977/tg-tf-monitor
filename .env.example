# 环境变量模板（Vercel 用 .env 或控制台；Cloudflare 用 wrangler secret / 控制台 Variables）
#
# 复制成 .env 只对本地 wrangler dev / vercel dev 有用；
# 线上请在平台控制台里配（Vercel: Settings → Environment Variables；CF: Settings → Variables and Secrets）。

# ── 必填 ──
# 找 @BotFather 发 /newbot 拿
TG_TOKEN=
# 目标会话 id。群是负数（-100…），私聊是正数。拿法见 README
TG_CHAT_ID=

# ── 强烈建议填 ──
# 保护 /run、/set-webhook 等运维端点；同时作为 Telegram Webhook 的 secret_token
# 随便一串长随机字符串，例如 `openssl rand -hex 24`
ADMIN_KEY=
TG_WEBHOOK_SECRET=

# ── Vercel 必填（Vercel 函数无状态，必须外接存储）──
# 去 upstash.com 建一个免费的 Redis，复制 REST URL 和 TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 可选 ──
# 只想打印不发送（部署前自检用）
DRY_RUN=
# Vercel Cron 的鉴权（Vercel 会自动带 Authorization: Bearer <CRON_SECRET>）
CRON_SECRET=
# 自定义 Telegram API 地址（自建 Bot API server 时用）
TG_API_BASE=
# 覆盖监控对象 / 发现源，整段 JSON，见 src/config.js 的 DEFAULT_CONFIG
# CONFIG_JSON={"watch":[{"code":"dTUO1uyt","label":"番茄小说 TF 公测","appStoreId":1468454200,"departuresId":16645}]}
CONFIG_JSON=
# 没有存储时也想跑一次（状态不持久化，会重复推送，仅试跑用）
ALLOW_NO_STORAGE=

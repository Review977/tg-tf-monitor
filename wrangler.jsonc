{
  // 用 wrangler.jsonc 而不是 wrangler.toml —— 与 Cloudflare 全部官方模板保持一致
  // （templates 里的 to-do-list-kv / agent-visibility / saas-admin 用的都是 jsonc）。
  // wrangler 两种格式都支持，但"部署按钮"这条链路我无法本地复现，
  // 所以不去赌它一定认 toml：跟官方模板对齐，少一个变量。
  "name": "tg-tf-monitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  // 两条 Cron：前者只监控，后者监控 + 全源发现。
  // 第二条要和 src/config.js 里的 cron.discovery 一致 ——
  // scheduled handler 靠比对 event.cron 决定跑哪个。
  // 免费版每账户最多 5 条 Cron Trigger，这里用 2 条。
  "triggers": {
    "crons": ["*/30 * * * *", "5 */6 * * *"]
  },
  // 状态存储（KV 命名空间 id）。
  // ⚠️ 注意这里是**真实的命名空间 id**，不是占位符 —— 因为本仓库走的是
  // 「导入仓库」（Import a repository）那条路，绑定直接读这个文件；
  // 只有「Deploy to Cloudflare」按钮那条路才会自动建 KV 并回写 id。
  // 换自己的：`wrangler kv namespace create STATE`，或控制台 Storage & Databases → KV。
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "961ebde900514f49b61de213e42961c4"
    }
  ]
}
